+++ b/comfy/model_management.py
@@ -819,7 +819,8 @@ class LoadedModel:
         return False
 
     def model_unload(self, memory_to_free=None, unpatch_weights=True):
-        if memory_to_free is not None:
+        # AMD: a partial unload leaves GBs of weights resident next to the next model; unload fully.
+        if memory_to_free is not None and AMD_VRAM_CAP is None:
             if memory_to_free < self.model.loaded_size():
                 freed = self.model.partially_unload(self.model.offload_device, memory_to_free)
                 if freed >= memory_to_free:
@@ -870,6 +871,17 @@ if args.reserve_vram is not None:
     EXTRA_RESERVED_VRAM = args.reserve_vram * 1024 * 1024 * 1024
     logging.debug("Reserving {}MB vram for other applications.".format(EXTRA_RESERVED_VRAM / (1024 * 1024)))
 
+# amdgpu cannot evict ROCm allocations for other clients: once PyTorch fills VRAM, the
+# compositor's command submissions fail with ENOMEM and the desktop session dies.
+# Hard-cap the allocator to the VRAM that was free at startup, minus room for the desktop.
+AMD_DESKTOP_VRAM_HEADROOM = 1024 * 1024 * 1024
+AMD_VRAM_CAP = None
+if is_amd() and get_torch_device().type == "cuda":
+    _amd_free, _amd_total = torch.cuda.mem_get_info(get_torch_device())
+    AMD_VRAM_CAP = _amd_free + torch.cuda.memory_reserved(get_torch_device()) - AMD_DESKTOP_VRAM_HEADROOM
+    torch.cuda.set_per_process_memory_fraction(AMD_VRAM_CAP / _amd_total, get_torch_device())
+    logging.info("AMD hard VRAM cap: {:.0f} MB of {:.0f} MB".format(AMD_VRAM_CAP / (1024 * 1024), _amd_total / (1024 * 1024)))
+
 def extra_reserved_memory():
     return EXTRA_RESERVED_VRAM
 
