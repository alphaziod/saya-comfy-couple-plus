             if lowvram_model_memory == 0:
                 lowvram_model_memory = 0.1
 
+            # AMD: a later call with a smaller estimate must not grow an already resident model
+            # into the headroom an earlier call reserved for activations and LoRA patching.
+            if AMD_VRAM_CAP is not None and loaded_memory > 0:
+                lowvram_model_memory = 0.1
