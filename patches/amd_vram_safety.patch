@@ -870,7 +871,32 @@
     EXTRA_RESERVED_VRAM = args.reserve_vram * 1024 * 1024 * 1024
     logging.debug("Reserving {}MB vram for other applications.".format(EXTRA_RESERVED_VRAM / (1024 * 1024)))
 
+# amdgpu cannot evict ROCm allocations for other clients: once PyTorch fills VRAM, the
+# compositor's command submissions fail with ENOMEM and the desktop session dies.
+# Hard-cap the allocator to the VRAM that was free at startup, minus room for the desktop.
+AMD_DESKTOP_VRAM_HEADROOM = 1024 * 1024 * 1024
+AMD_VRAM_CAP = None
+if is_amd() and get_torch_device().type == "cuda":
+    _amd_free, _amd_total = torch.cuda.mem_get_info(get_torch_device())
+    AMD_VRAM_CAP = _amd_free + torch.cuda.memory_reserved(get_torch_device()) - AMD_DESKTOP_VRAM_HEADROOM
+    # Another process (a running ComfyUI, a test harness) may already hold most of the VRAM: the cap would be
+    # negative or tiny and set_per_process_memory_fraction would raise at import. Clamp it, say so, keep going
+    # (such a process will OOM cleanly later instead of crashing every `import comfy`).
+    AMD_VRAM_CAP_MINIMUM_FRACTION = 0.05
+    _amd_fraction = AMD_VRAM_CAP / _amd_total
+    if not AMD_VRAM_CAP_MINIMUM_FRACTION <= _amd_fraction <= 1.0:
+        logging.warning("AMD hard VRAM cap: only {:.0f} MB of {:.0f} MB free at startup (another process holds the VRAM?): "
+                        "cap clamped to {:.0%} of the VRAM".format(max(_amd_free, 0) / (1024 * 1024), _amd_total / (1024 * 1024),
+                                                                 min(max(_amd_fraction, AMD_VRAM_CAP_MINIMUM_FRACTION), 1.0)))
+        _amd_fraction = min(max(_amd_fraction, AMD_VRAM_CAP_MINIMUM_FRACTION), 1.0)
+        AMD_VRAM_CAP = int(_amd_fraction * _amd_total)
+    torch.cuda.set_per_process_memory_fraction(_amd_fraction, get_torch_device())
+    logging.info("AMD hard VRAM cap: {:.0f} MB of {:.0f} MB".format(AMD_VRAM_CAP / (1024 * 1024), _amd_total / (1024 * 1024)))
+
 def extra_reserved_memory():
+    if AMD_VRAM_CAP is not None:
+        # get_free_memory already excludes the hard cap's desktop reserve.
+        return max(0, EXTRA_RESERVED_VRAM - AMD_DESKTOP_VRAM_HEADROOM)
     return EXTRA_RESERVED_VRAM
 
 def minimum_inference_memory():
