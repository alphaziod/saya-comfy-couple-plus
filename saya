#!/bin/sh
# Saya installer launcher (Linux / macOS): Saya Couple nodes and/or the Saya Studio app.
# Usage: ./saya install [--what nodes|app|both] | studio | verify | restore | check-compat | amd
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="${SAYA_PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || PY=python
exec "$PY" "$HERE/installer/saya.py" "$@"
