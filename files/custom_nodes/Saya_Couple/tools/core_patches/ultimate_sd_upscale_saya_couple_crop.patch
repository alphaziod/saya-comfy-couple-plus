+# ---------------------------------------------------------------------------
+# Saya layer 2 -- IDENTITY / STRUCTURE PRESERVATION  (V2, per-tile, default OFF)
+#
+# A low-denoise img2img tile pass repaints sub-tile structure -- iris / pupil /
+# eye contour, hair strands, fingers, small text, keyboard grids, thin lines,
+# accessory outlines.  A *displaced or redrawn* structure is broad-band: it
+# lives in the low, mid AND high spatial-frequency bands, so a plain low-pass
+# swap (V1) still keeps H(O) at 100% and therefore keeps part of USDU's
+# structural re-design.
+#
+# V2 is a MULTI-SCALE, EDGE-AWARE reconstruction.  An a-trous (non-decimated)
+# Gaussian stack gives L band-pass levels + a residual; each level is blended
+# with a SPATIAL weight that is high only where the SOURCE itself carries
+# strong structure at that scale.  Where the source is flat (skin, wall) the
+# weight is ~0 and USDU's genuinely new micro-texture passes through untouched.
+#
+#   G^X_0 = X ;  G^X_k = Gauss_{sigma_k}(G^X_{k-1}) ;  sigma_k = sigma_0 * 2^(k-1)
+#   Lap^X_k = G^X_{k-1} - G^X_k        (k = 1..L)      Res^X = G^X_L
+#
+#   ES_k  = Gauss_{sigma_k}( | Lap^{Yluma(S)}_k | )               (source band energy)
+#   EO_k  = Gauss_{sigma_k}( | Lap^{Yluma(O)}_k | )               (output band energy)
+#   den_k = max( Q95(ES_k), tau_hi )         (abs floor: a near-flat tile/level
+#                                             cannot self-normalise up to m~1)
+#   m_k   = clip( (ES_k - tau_lo) / (den_k - tau_lo + eps), 0, 1 ) ** gamma
+#   mhat_k= clip( beta * Gauss_{0.5 sigma_k}(m_k), 0, 1 )         (protection halo)
+#   a_k   = a_min + (a_max - a_min) * (k-1)/(L-1)                 (coarser -> protect more)
+#   w_k   = clip( s * a_k * mhat_k, 0, s )                        (reinstate source band)
+#   xs_k  = clip( (EO_k - ES_k - tau_lo) / (den_k - tau_lo + eps), 0, 1 )  (invented energy)
+#   sup_k = clip( s * mhat_k * xs_k, 0, s )         (extra kill of a *displaced* edge)
+#
+#   cS_k  = w_k                              cO_k = (1 - w_k) * (1 - sup_k)
+#   Lap^R_k = cS_k * Lap^S_k + cO_k * Lap^O_k
+#   Res^R   = (1 - s * a_res) * Res^O + s * a_res * Res^S     (a_res = 1)
+#   R       = clip( sum_k Lap^R_k + Res^R , 0, 255 )
+#
+#   * The stack telescopes: sum_k Lap^X_k + Res^X == X exactly, so cS=0,cO=1
+#     reconstructs O exactly (and s <= 0 early-returns O -> bitwise upstream).
+#   * H(O) is NOT kept blindly.  An output band keeps weight 1 only where
+#     mhat_k ~ 0 -- source had no structure at that scale (flat skin/wall:
+#     genuine new micro-texture passes untouched).  On a sharp source edge
+#     (iris rim, letter stroke, key border, finger contour) the source band is
+#     reinstated at its own scale; where the output *invented* band energy the
+#     source lacks (a displaced edge sitting next to the real one), sup_k
+#     removes it, pulling centroids / contours back to the source.
+#   * s = 1 with the full residual swap contains the V1 low-frequency guarantee
+#     (gross geometry, colour) as a subset.
+#
+# Purely geometric / gradient-based: no semantic model, no detector, no
+# hardcoded positions.  Works whether Forge Couple is present, absent or
+# mis-routed.  Single slider: structure_preservation = s in [0, 1].
+# ---------------------------------------------------------------------------
+_SP_LEVELS = 5
+_SP_A_MIN = 0.85
+_SP_A_MAX = 1.0
+_SP_GAMMA = 0.75
+_SP_BETA = 2.0
+_SP_Q = 95.0
+_SP_TAU_LO = 2.0        # smoothed |Lap(luma)| noise pedestal (8-bit units)
+_SP_TAU_HI = 6.0        # absolute "this is real structure" scale
+_SP_EPS = 1e-6
+
+
+def _sp_box1d(a: "np.ndarray", r: int, axis: int) -> "np.ndarray":
+    """O(N) box blur of radius r along `axis`, reflect-padded.
+
+    V2.1 robustness: the reflect pad needs r <= n-1 pixels on the axis, so a
+    requested radius wider than the axis is clamped to n-1 (a box spanning the
+    whole axis -- the coherent limit when sigma exceeds the tile dimension).
+    An axis of length 1 is already its own mean -> returned unchanged.  For
+    every dimension >= the normal tile minimum this clamp never triggers, so
+    results are byte-for-byte identical to V2 there.
+    """
+    if r < 1:
+        return a
+    a = np.moveaxis(a, axis, 0)
+    n = a.shape[0]
+    r = min(int(r), n - 1)
+    if r < 1:
+        return np.moveaxis(a, 0, axis)
+    pad = np.concatenate([a[1:r + 1][::-1], a, a[n - r - 1:n - 1][::-1]], axis=0)
+    csum = np.cumsum(pad, axis=0)
+    csum = np.concatenate([np.zeros_like(csum[:1]), csum], axis=0)
+    out = (csum[2 * r + 1:] - csum[:-(2 * r + 1)]) / float(2 * r + 1)
+    return np.moveaxis(out, 0, axis)
+
+
+def _sp_gauss(arr: "np.ndarray", sigma: float) -> "np.ndarray":
+    """Separable Gaussian approximation (3 iterated box blurs), any HxW[xC]
+    float array.  No PIL 'F'-mode dependency; O(N) in pixels regardless of
+    sigma.  Same operator is used for the stack and the reconstruction, so the
+    a-trous decomposition still telescopes exactly."""
+    a = arr.astype(np.float32, copy=True)
+    if sigma <= 0:
+        return a
+    r = max(1, int(round((-1.0 + (1.0 + 4.0 * sigma * sigma) ** 0.5) / 2.0)))
+    for _ in range(3):
+        a = _sp_box1d(a, r, 0)
+        a = _sp_box1d(a, r, 1)
+    return a
+
+
+def _sp_stack(arr: "np.ndarray", sigmas):
+    """a-trous Gaussian stack -> (list of L band-pass levels, residual)."""
+    levels = []
+    prev = arr
+    for sig in sigmas:
+        cur = _sp_gauss(prev, sig)
+        levels.append(prev - cur)
+        prev = cur
+    return levels, prev
+
+
+def structure_preserve_tile(source_pil: Image.Image, output_pil: Image.Image,
+                            strength: float) -> Image.Image:
+    s = float(strength)
+    if s <= 0.0:                       # bitwise upstream
+        return output_pil
+    s = min(s, 1.0)
+
+    out = output_pil.convert("RGB")
+    src = source_pil.convert("RGB")
+    if src.size != out.size:
+        src = src.resize(out.size, Image.Resampling.LANCZOS)
+
+    O = np.asarray(out, dtype=np.float32)
+    S = np.asarray(src, dtype=np.float32)
+    h, w = O.shape[:2]
+
+    L = _SP_LEVELS
+    sigma0 = max(1.0, min(w, h) / 256.0)
+    sigmas = [sigma0 * (2.0 ** k) for k in range(L)]
+
+    lap_O, res_O = _sp_stack(O, sigmas)
+    lap_S, res_S = _sp_stack(S, sigmas)
+
+    # per-band structure energy, from luma, for source AND output
+    def _luma(a):
+        return (0.299 * a[..., 0] + 0.587 * a[..., 1] + 0.114 * a[..., 2]).astype(np.float32)
+    lap_YS, _ = _sp_stack(_luma(S), sigmas)
+    lap_YO, _ = _sp_stack(_luma(O), sigmas)
+
+    recon = np.zeros_like(O)
+    for k in range(L):
+        es = _sp_gauss(np.abs(lap_YS[k]), sigmas[k])
+        eo = _sp_gauss(np.abs(lap_YO[k]), sigmas[k])
+        den = max(float(np.percentile(es, _SP_Q)), _SP_TAU_HI) - _SP_TAU_LO + _SP_EPS
+        m = np.clip((es - _SP_TAU_LO) / den, 0.0, 1.0) ** _SP_GAMMA
+        mhat = np.clip(_SP_BETA * _sp_gauss(m, 0.5 * sigmas[k]), 0.0, 1.0)
+        a_k = _SP_A_MIN + (_SP_A_MAX - _SP_A_MIN) * (k / (L - 1) if L > 1 else 0.0)
+        w_k = np.clip(s * a_k * mhat, 0.0, s)
+        xs = np.clip((eo - es - _SP_TAU_LO) / den, 0.0, 1.0)      # invented energy
+        sup = np.clip(s * mhat * xs, 0.0, s)
+        cS = w_k[..., None]
+        cO = ((1.0 - w_k) * (1.0 - sup))[..., None]
+        recon += cS * lap_S[k] + cO * lap_O[k]
+
+    recon += (1.0 - s) * res_O + s * res_S                        # a_res = 1
+
+    np.clip(recon, 0.0, 255.0, out=recon)
+    return Image.fromarray(recon.astype(np.uint8), mode="RGB")
+
