+# ---------------------------------------------------------------------------
+# Saya layer 1 -- COUPLE CROP REMAP (opt-in, default OFF)
+#
+# When SAYA_USDU_COUPLE_CROP is truthy, expose the real per-tile crop region to
+# a downstream regional-attention engine (SayaForgeCouple) so it can crop its
+# full-image routing masks to the tile BEFORE interpolating them, instead of
+# squashing the whole P1->P2 gradient into the tile.  This only writes metadata
+# onto the *per-tile clone*; it never mutates the shared MODEL and never leaks
+# to the next tile.  A consumer that does not understand the key ignores it.
+#
+# This does NOT protect identity/structure -- see layer 2 in modules/processing.py.
+# ---------------------------------------------------------------------------
+SAYA_COUPLE_CROP_ENV = "SAYA_USDU_COUPLE_CROP"
+
+
+def _saya_couple_crop_enabled() -> bool:
+    return os.environ.get(SAYA_COUPLE_CROP_ENV, "").strip().lower() in (
+        "1", "true", "yes", "on",
+    )
+
+
+def _attach_saya_couple_crop(patched_model, crop_regions, canvas_size) -> None:
+    """Attach transformer_options['saya_couple_crop'] to a per-tile model clone.
+
+    Single region only (batch_size == 1).  For a batched multi-region sample
+    call there is no verified one-dict-per-batch-item contract, so nothing is
+    attached and the consumer falls back to its own mismatch handling.
+    """
+    try:
+        region = crop_regions
+        if isinstance(region, list):
+            region = region[0] if len(region) == 1 else None
+        if not (isinstance(region, (tuple, list)) and len(region) == 4):
+            return
+        if not (isinstance(canvas_size, (tuple, list)) and len(canvas_size) == 2):
+            return
+        x1, y1, x2, y2 = (float(v) for v in region)
+        if not (x2 > x1 and y2 > y1):
+            return
+        transformer_options = patched_model.model_options.setdefault(
+            "transformer_options", {}
+        )
+        transformer_options["saya_couple_crop"] = {
+            "crop_region": [x1, y1, x2, y2],
+            "full_width": int(canvas_size[0]),
+            "full_height": int(canvas_size[1]),
+            "label": "USDU",
+        }
+        logger.debug(
+            "Saya couple crop attached: region=%s full=%s",
+            (x1, y1, x2, y2), tuple(canvas_size),
+        )
+    except Exception:  # never break the upscale over optional metadata
+        logger.debug("Saya couple crop: skipped (attach failed)", exc_info=True)
+
 
 @contextmanager
 def crop_model_cond(
@@ -23,6 +79,10 @@ def crop_model_cond(
     # Clone is probably not useful, since we have to manage patch state changes anyway due
     # to ComfyUI commit fe053ba
     patched_model = model.clone()
+
+    if _saya_couple_crop_enabled():
+        _attach_saya_couple_crop(patched_model, crop_regions, canvas_size)
+
     patches = patched_model.model_options.get("transformer_options", {}).get(
         "patches", {}
     )
