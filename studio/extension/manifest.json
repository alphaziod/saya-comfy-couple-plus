{
  "manifest_version": 3,
  "name": "Saya Studio — Civitai Bridge",
  "version": "1.1.0",
  "description": "Télécharge les modèles Civitai directement dans Saya Studio.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://civitai.com/*",
    "https://*.civitai.com/*",
    "https://civitai.red/*",
    "https://*.civitai.red/*",
    "http://127.0.0.1:47821/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://civitai.com/*",
        "https://*.civitai.com/*",
        "https://civitai.red/*",
        "https://*.civitai.red/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Saya Studio Civitai Bridge"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
