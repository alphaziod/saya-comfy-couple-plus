{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saya Studio",
  "version": "1.0.0-beta.1",
  "identifier": "studio.saya.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Saya Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Local image, character and ComfyUI workflow manager",
    "longDescription": "Saya Studio is a local desktop application for making anime-style character images with ComfyUI as the external render engine. It manages casting, galleries, character sheets, models and LoRAs, and multi-pass workflows. Nothing runs in the cloud.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../docs/SAUVEGARDES.md": "docs/SAUVEGARDES.md",
      "../sidecars/f09-semantic-embed.py": "sidecars/f09-semantic-embed.py"
    },
    "linux": {
      "deb": {
        "depends": [
          "libsoup-3.0-0",
          "python3",
          "curl",
          "xdg-utils",
          "xdg-desktop-portal"
        ],
        "files": {
          "/usr/bin/saya-studio-maintenance": "../target/release/studio-maintenance",
          "/usr/share/saya-studio/civitai_bridge.py": "../scripts/civitai_bridge.py",
          "/usr/share/saya-studio/saya_native_host.py": "../scripts/saya_native_host.py",
          "/usr/share/saya-studio/sidecars/f09-semantic-embed.py": "../sidecars/f09-semantic-embed.py",
          "/usr/share/saya-studio/presets": "../presets",
          "/usr/share/saya-studio/extension": "../extension",
          "/usr/share/saya-studio/com.saya.studio.json": "../packaging/linux/com.saya.studio.json",
          "/etc/opt/chrome/native-messaging-hosts/com.saya.studio.json": "../packaging/linux/com.saya.studio.json",
          "/etc/chromium/native-messaging-hosts/com.saya.studio.json": "../packaging/linux/com.saya.studio.json",
          "/usr/share/doc/saya-studio/SAUVEGARDES.md": "../docs/SAUVEGARDES.md"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libsoup3",
          "python3",
          "curl",
          "xdg-utils",
          "xdg-desktop-portal"
        ],
        "files": {
          "/usr/bin/saya-studio-maintenance": "../target/release/studio-maintenance",
          "/usr/share/saya-studio/civitai_bridge.py": "../scripts/civitai_bridge.py",
          "/usr/share/saya-studio/saya_native_host.py": "../scripts/saya_native_host.py",
          "/usr/share/saya-studio/sidecars/f09-semantic-embed.py": "../sidecars/f09-semantic-embed.py",
          "/usr/share/saya-studio/presets": "../presets",
          "/usr/share/saya-studio/extension": "../extension",
          "/usr/share/saya-studio/com.saya.studio.json": "../packaging/linux/com.saya.studio.json",
          "/etc/opt/chrome/native-messaging-hosts/com.saya.studio.json": "../packaging/linux/com.saya.studio.json",
          "/etc/chromium/native-messaging-hosts/com.saya.studio.json": "../packaging/linux/com.saya.studio.json",
          "/usr/share/doc/saya-studio/SAUVEGARDES.md": "../docs/SAUVEGARDES.md"
        }
      }
    }
  }
}
